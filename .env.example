# Project environment — single file for all local settings.
# Copy to .env and adjust before first run:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Docker build settings
# ---------------------------------------------------------------------------
DOCKER_BUILDKIT=0
COMPOSE_DOCKER_CLI_BUILD=0
COMPOSE_PARALLEL_LIMIT=1

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------
DASHBOARD_PORT=8501
CLIENT_APP_PORT=8502
MONGODB_PORT=27017

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=ensaj_client_portal

# ---------------------------------------------------------------------------
# docker_per_user FL deployment
# ---------------------------------------------------------------------------
DEPLOYMENT_MODE=docker_per_user
PORTAL_HOSTNAME=ensaj-client-app

# IMPORTANT: set these to ABSOLUTE host paths before running.
# Windows: FL_ARTIFACT_ROOT_HOST=C:/Users/you/ensaj/artifacts
# Linux:   FL_ARTIFACT_ROOT_HOST=/home/you/ensaj/artifacts
FL_ARTIFACT_ROOT_HOST=./artifacts
FL_DATA_ROOT_HOST=./data
FL_CONFIG_ROOT_HOST=./config

FL_DOCKER_IMAGE=ensaj-fl-client
FL_DOCKER_NETWORK=ensaj_fl-net
